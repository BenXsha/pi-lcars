{
  "name": "pi-lcars",
  "version": "0.3.2",
  "description": "LCARS agent console for pi — one command boots the web UI and the in-process pi backend",
  "license": "MIT",
  "author": {
    "name": "BenShawn",
    "email": "benxshare@hotmail.com",
    "url": "https://gitee.com/benshawn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/benshawn/pi-lcars.git"
  },
  "type": "module",
  "bin": {
    "pi-lcars": "bin/pi-lcars.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "lcars",
    "agent",
    "console",
    "web-ui"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepack": "vite build",
    "start": "node bin/pi-lcars.mjs",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "server": "node server/index.mjs",
    "test": "node test/pi-env.mjs && node test/fonts.mjs && node test/mcp-config.mjs && node test/smoke.mjs && node test/launch.mjs && node test/ui.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:launch": "node test/launch.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "test:ui": "node test/ui.mjs",
    "test:mcp": "node test/mcp-config.mjs",
    "test:fonts": "node test/fonts.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "preact": "^11.1.0",
    "remixicon": "^4.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "homepage": "https://gitee.com/benshawn/pi-lcars",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
