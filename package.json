{
  "name": "pi-lcars",
  "version": "0.5.2",
  "description": "LCARS agent console for pi — one command boots the web UI and the in-process pi backend",
  "license": "MIT",
  "author": {
    "name": "BenShawn",
    "email": "benxshare@hotmail.com",
    "url": "https://gitee.com/benshawn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenXsha/pi-lcars.git"
  },
  "type": "module",
  "bin": {
    "pi-lcars": "bin/pi-lcars.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "extensions/",
    "dist/",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "lcars",
    "agent",
    "console",
    "web-ui",
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepack": "vite build",
    "start": "node bin/pi-lcars.mjs",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "server": "node server/index.mjs",
    "test": "node scripts/check-themes.mjs && node test/pi-env.mjs && node test/fonts.mjs && node test/braille.mjs && node test/extension.mjs && node test/mcp-config.mjs && node test/smoke.mjs && node test/launch.mjs && node test/ui.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:launch": "node test/launch.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "test:ui": "node test/ui.mjs",
    "test:mcp": "node test/mcp-config.mjs",
    "test:fonts": "node test/fonts.mjs",
    "release": "node scripts/build-release.mjs",
    "test:braille": "node test/braille.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "node scripts/check-release.mjs && npm test",
    "check:extension": "node test/extension.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "preact": "^11.1.0",
    "remixicon": "^4.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "homepage": "https://github.com/BenXsha/pi-lcars",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/BenXsha/pi-lcars/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/lcars.ts"
    ],
    "image": "https://cdn.jsdelivr.net/gh/BenXsha/pi-lcars@main/docs/console.png"
  }
}
